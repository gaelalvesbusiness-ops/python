# HonestPool Scraper - 2Captcha settings (template with placeholders only)
#
# Windows 11: do not use this file. Double-click configurar_2captcha.bat instead; it stores the
# key encrypted for your Windows user (INSTALACAO_WINDOWS_11.md, section 5).
#
# Linux/macOS or manual use:
# 1. Copy this file to .env in the same folder (.env is in .gitignore).
# 2. Paste your own key from the 2Captcha dashboard after CAPTCHA_API_KEY= (no quotes, no spaces).
# 3. Load .env into the terminal before running main.py (docs/CLIENT_GUIDE.md, section 9A).
#    The program reads environment variables only; it never opens .env by itself.
#
# Never commit .env, send it by message or include it in a delivery package.
# With CAPTCHA_API_KEY left empty, CAPTCHAs are completed manually in the browser window.

CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY=
CAPTCHA_TIMEOUT=120
